# Copy the lines you need into your platform's environment/secrets settings.
# (On Hugging Face Spaces: Settings -> Variables and secrets.)

# Port the server listens on. HF Spaces uses app_port (7860) from README.md.
PORT=7860

# Session lifetime for each unlocked user (minutes). Default 30.
TTL_MINUTES=30

# WebSocket path for the vless inbound. Default /ws
WS_PATH=/ws

# Force the generated vless:// links to use your own domain (e.g. Cloudflare).
# Leave EMPTY while testing - links then derive from the host that calls you.
# PUBLIC_HOST=vpn-test.yourdomain.com
PUBLIC_HOST=
# Port & TLS to advertise together with PUBLIC_HOST
PUBLIC_PORT=443
# PUBLIC_SECURITY=auto|tls|none  (auto = tls for PUBLIC_HOST, else infer from X-Forwarded-Proto)
PUBLIC_SECURITY=auto

# HMAC secret for ad-reward tokens. CHANGE THIS before semi-public testing.
DEV_GRANT_SECRET=dev-secret-CHANGE-ME-1
# Token validity window in seconds (time to redeem after ad completion). Default 300.
TOKEN_TTL_SECONDS=300

# Allow the simulated-ad /api/v1/dev-grant endpoint (testing only). Set 0 for prod.
ADMIT_DEV_GRANTS=1

# Admin API (list/revoke sessions). Required header x-admin-token.
ADMIN_TOKEN=
